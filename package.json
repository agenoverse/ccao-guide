{
  "name": "cc-sor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd system/site && bun run dev",
    "build": "ksor build && cd system/site && bun run build",
    "preview": "node system/site/preview.mjs",
    "check": "node .agents/skills/format-checker/check.mjs",
    "provision": "bun run schema && bun run grant",
    "serve": "ksor serve",
    "refresh": "ksor build && bun run ingest && bun run gc",
    "schema": "ksor schema --instance instance.md --apply",
    "grant": "ksor grant --instance instance.md",
    "ingest": "ksor ingest --instance instance.md --flip",
    "gc": "ksor gc --instance instance.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@panaversity/ksor": "0.0.60",
    "fumadocs-core": "^16.15.15",
    "fumadocs-mdx": "^15.4.5",
    "fumadocs-ui": "^16.15.15"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "system/site",
    "system/gateways/*",
    "system/packages/*"
  ]
}
